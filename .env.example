# Shared by the shop and the payment provider. Demo values: generate real ones with `openssl rand -hex 32`.
WEBHOOK_SECRET=demo-webhook-secret
PAYMENTS_API_KEY=demo-payments-api-key

# Where each service listens and the address the browser reaches it on.
APP_PORT=3000
APP_PUBLIC_URL=http://localhost:3000
PAYMENTS_PORT=4000
PAYMENTS_PUBLIC_URL=http://localhost:4000

# Databases for runs without Docker. Compose points the containers at its own MongoDB.
MONGO_URL=mongodb://127.0.0.1:27017/sneakdrop
PAYMENTS_MONGO_URL=mongodb://127.0.0.1:27017/payments

# The sale.
STOCK=20
HOLD_SECONDS=300
PRICE_CENTS=15000

# How unreliable the provider's payment messages are.
WEBHOOK_MAX_DELAY_MS=3000
WEBHOOK_DUPLICATE_RATE=0.3
